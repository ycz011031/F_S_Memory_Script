[global]
bs=${SIZE}
ioengine=libaio
thread=1
numjobs=${NUM_THREADS}
norandommap=0
group_reporting=1
iodepth=${IODEPTH}
direct=1
time_based=1
runtime=10000
ramp_time=0
iodepth_batch_submit=${SUBMIT_BATCH}
iodepth_batch_complete_min=${COMP_BATCH}
iodepth_batch_complete_max=${IODEPTH}

offset=2G
size=64G

write_bw_log=${OUT_DIR}/fio_bw_${RW}_${SIZE}
write_iops_log=${OUT_DIR}/fio_iops_${RW}_${SIZE}
write_lat_log=${OUT_DIR}/fio_lat_${RW}_${SIZE}
log_avg_msec=5000

[test]
rw=${RW}
filename=/dev/nvme0n1
